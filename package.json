{
  "name": "@foreverlearning/learn-mcp",
  "version": "0.1.0",
  "description": "The Learn API for coding assistants: its guide, contract and verified Build with Learn kits, and a capped test turn with your own key.",
  "mcpName": "ai.foreverlearning/learn",
  "license": "MIT",
  "author": "ForeverLearning AI",
  "homepage": "https://developers.foreverlearning.ai/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/foreverlearning-engineering/learn-mcp.git"
  },
  "bugs": {
    "email": "developers@foreverlearning.ai"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "learn-api",
    "tutor",
    "tutoring",
    "education",
    "learning"
  ],
  "type": "module",
  "bin": {
    "learn-mcp": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./http": {
      "types": "./dist/http.d.ts",
      "default": "./dist/http.js"
    }
  },
  "files": [
    "dist",
    "snapshot",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.check.json",
    "test": "node --test --test-concurrency=1 test/*.test.ts",
    "snapshot": "node scripts/snapshot.mjs",
    "start": "node dist/cli.js",
    "prepack": "npm run build && npm test"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "2.1.2",
    "@modelcontextprotocol/server": "2.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "@types/node": "24.19.2",
    "typescript": "7.0.2"
  }
}
